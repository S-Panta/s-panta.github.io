---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<any>[];
  base: string;
}
const { entries, base } = Astro.props;
---

<ul class="post-list">
  {
    entries.map((e) => (
      <li>
        <a href={`/${base}/${e.id}/`}>{e.data.title}</a>
        <time datetime={e.data.pubDate.toISOString()}>
          {e.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC",
          })}
        </time>
        <p class="snippet">{e.data.description}</p>
      </li>
    ))
  }
</ul>
