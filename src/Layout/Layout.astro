---
import "../pages/styles/styles.css";
import Nav from "../components/Nav.astro";
const { title = "Sabin Panta", wide = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>

    <body>
        <Nav />
        <main class={wide ? "container container--wide" : "container"}>
            <slot />
        </main>
    </body>
</html>
