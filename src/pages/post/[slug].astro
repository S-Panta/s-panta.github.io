---
import Layout from "../../Layout/Layout.astro";
import type { GetStaticPaths } from "astro";

const posts = Object.entries(
    import.meta.glob("../../content/blogs/*.md", { eager: true }),
);
const urlForRecentPost = (file: string) => {
    const slug = file.split("/").at(-1)?.replace(".md", "");
    return `/post/${slug}`;
};

export const getStaticPaths = (async () => {
    const posts = Object.entries(
        import.meta.glob("../../content/blogs/*.md", {
            eager: true,
        }),
    );
    return posts.map(([file, post]: any) => {
        const parts = file.split("/");

        const slug = parts.at(-1).replace(".md", "");

        return {
            params: {
                slug,
            },
            props: {
                post,
            },
        };
    });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = post;
const { slug } = Astro.params;

// newest first, skip the post being read, show at most 5
const recentPosts = posts
    .filter(([file]) => urlForRecentPost(file) !== `/post/${slug}`)
    .sort(
        ([, a]: any, [, b]: any) =>
            new Date(b.frontmatter.pubDate).getTime() -
            new Date(a.frontmatter.pubDate).getTime(),
    )
    .slice(0, 5);
---

<Layout title={post.frontmatter.title} wide>
    <!-- <p>{post.frontmatter.title}</p>
    <p>Written by: {post.frontmatter.author}</p> -->
    <div class="article-layout">
        <article class="post-body"><Content /></article>
        <!-- <Content /> -->

        <aside class="archive">
            <p class="archive-title">Recent Articles</p>
            <ul>
                {
                    recentPosts.map(([file, post]: any) => (
                        <li>
                            <a href={urlForRecentPost(file)}>
                                {post.frontmatter.title}
                            </a>
                            <p class="snippet">
                                {post.frontmatter.description}
                            </p>
                        </li>
                    ))
                }
            </ul>
        </aside>
    </div>
</Layout>
